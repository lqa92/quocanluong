}

/* ---------------- TEST ---------------- */
function startTest(){
  const all=QUESTIONS.map((_,k)=>k);
  let pool=all.filter(k=>!lastSet.includes(k));
  if(pool.length<TEST_N) pool=all;
  const ids=shuffle(pool.slice()).slice(0,TEST_N);
  lastSet=ids;
  test={ids,i:0,ans:{},start:Date.now(),deadline:Date.now()+TEST_SEC*1000,done:false,timeout:false};
  reviewFilter='all';
  startTimer(); renderTest();
}
function startTimer(){stopTimer();timerId=setInterval(tick,250);}
function stopTimer(){if(timerId){clearInterval(timerId);timerId=null;}}
function tick(){
  if(!test||test.done) return stopTimer();
  const left=(test.deadline-Date.now())/1000;
  const el=document.getElementById('timer');
  if(el){el.textContent='⏱ '+fmt(left);el.classList.toggle('low',left<=60);}
  if(left<=0){test.timeout=true;finishTest();}
}
function answeredCount(){return Object.keys(test.ans).length;}
function renderTest(scroll=true){
  view='test';
  const k=test.ids[test.i], q=QUESTIONS[k], a=test.ans[k];
  const left=(test.deadline-Date.now())/1000;
  hdr.innerHTML=`<span class="pill timer ${left<=60?'low':''}" id="timer">⏱ ${fmt(left)}</span>`;
  const n=answeredCount(), all=n===TEST_N;
  const grid=test.ids.map((id,j)=>`<button class="cell ${test.ans[id]!==undefined?'done':''} ${j===test.i?'cur':''}" data-act="tgoto" data-k="${j}">${j+1}</button>`).join('');
  app.innerHTML=`
  <div class="row" style="justify-content:space-between;margin-top:8px"><span class="muted">Kiểm tra · Câu ${test.i+1}/${TEST_N}</span><span class="muted">Đã trả lời ${n}/${TEST_N}</span></div>
  <div class="prog warm"><i style="width:${n/TEST_N*100}%"></i></div>
  <article class="card">
    ${qBlock(q,'Câu '+(test.i+1))}
    ${optsBlock(q,i=>i===a?'sel':'',false)}
  </article>
  <div class="nav">
    <button class="btn" data-act="tprev" ${test.i===0?'disabled':''}>← Câu trước</button>
    <button class="btn primary grow" data-act="tnext" ${test.i===TEST_N-1?'disabled':''}>Câu tiếp theo →</button>
  </div>
  <div class="navi"><div class="grid">${grid}</div>
    <div class="legend"><span><i style="background:var(--accent-soft);border:1px solid #a9c6dc"></i>Đã trả lời</span><span><i style="background:#fff;border:1px solid var(--line-2)"></i>Chưa trả lời</span></div>
  </div>
  <div class="submit">
    <span class="muted">${all?'Bạn đã trả lời đủ 20 câu. Có thể đổi đáp án trước khi nộp.':`Còn ${TEST_N-n} câu chưa trả lời. Làm đủ ${TEST_N} câu mới nộp được bài.`}</span>
    <button class="btn warm" data-act="submit" ${all?'':'disabled'}>Nộp bài</button>
  </div>
  <div class="kbd">Phím tắt: <span>1</span>–<span>4</span> chọn đáp án · <span>←</span> <span>→</span> chuyển câu</div>`;
  if(scroll) top0();
}
function finishTest(){
  if(!test||test.done) return;
  test.done=true; test.used=Math.min(TEST_SEC,(Date.now()-test.start)/1000); stopTimer(); renderResult();
}
function renderResult(){
  view='result'; hdr.innerHTML='';
  const items=test.ids.map((k,j)=>({j,q:QUESTIONS[k],a:test.ans[k]}));
  const ok=items.filter(x=>x.a===x.q.a).length, no=TEST_N-ok;
  const unanswered=items.filter(x=>x.a===undefined).length;
  const list=items.filter(x=>reviewFilter==='all'||x.a!==x.q.a);
  const msg=ok>=18?'Xuất sắc!':ok>=15?'Rất tốt!':ok>=10?'Khá ổn, cố thêm chút nữa!':'Hãy ôn lại và thử lại nhé!';
  app.innerHTML=`
  <article class="card" style="margin-top:16px">
    ${test.timeout?`<div class="timeout">Hết giờ — bài đã được nộp tự động${unanswered?` (${unanswered} câu chưa trả lời tính là sai)`:''}</div>`:''}
    <div class="score">
      <div class="ring" style="--p:${ok/TEST_N*100}"><div><div><b>${ok}</b><small>/ ${TEST_N} câu</small></div></div></div>
      <div><h2 style="margin:0 0 2px">${msg}</h2>
        <div class="stats"><span class="stat ok">Đúng ${ok}</span><span class="stat no">Sai ${no}</span><span class="stat t">Thời gian ${fmt(test.used)}</span></div>
        <div class="row"><button class="btn warm" data-act="test">Làm đề mới (${TEST_N} câu khác)</button><button class="btn" data-act="home">Trang chủ</button></div>
      </div>
    </div>
  </article>
  <div class="tabs"><button class="tab ${reviewFilter==='all'?'on':''}" data-act="filter" data-f="all">Tất cả (${TEST_N})</button><button class="tab ${reviewFilter==='wrong'?'on':''}" data-act="filter" data-f="wrong">Câu sai (${no})</button></div>
  <div class="review">${list.length?list.map(({j,q,a})=>{
    const right=a===q.a;
    const cls=i=>i===q.a?'correct':(i===a?'wrong':'dim');
    const tag=i=>i===q.a?'<span class="tag ok">Đáp án đúng</span>':(i===a?'<span class="tag no">Bạn chọn</span>':'');
    return `<article class="card">${qBlock(q,'Câu '+(j+1),`<span class="orig">(câu ${q.n} trong đề gốc)</span>`)}
      ${optsBlock(q,cls,true,tag)}
      <div class="fb ${right?'ok':(a===undefined?'neutral':'no')}"><div class="fb-h">${right?'Đúng':(a===undefined?'Chưa trả lời':'Sai')} · Đáp án đúng: ${CIRC[q.a]}${!right&&a!==undefined?` · Bạn chọn: ${CIRC[a]}`:''}</div><div class="fb-b">${q.e}</div></div>
    </article>`;}).join(''):'<p class="muted">Không có câu sai. Tuyệt vời!</p>'}</div>`;
  top0();
}

/* ---------------- events ---------------- */
document.addEventListener('click',e=>{
  const t=e.target.closest('[data-act]'); if(!t) return;
  const act=t.dataset.act;
  if(t.tagName==='A') e.preventDefault();
  if(act==='home'){
    if(view==='test'&&test&&!test.done&&!confirm('Bài kiểm tra chưa nộp sẽ bị hủy. Về trang chủ?')) return;
    if(view==='test'&&test&&!test.done){test=null;}
    return renderHome();
  }
  if(act==='practice') return renderPractice();
  if(act==='test'){
    if(view==='test'&&test&&!test.done) return;
    return startTest();
  }
  /* practice */
  if(view==='practice'||view==='psummary'){
    if(act==='pick'){const q=QUESTIONS[practice.i];if(practice.ans[q.n]===undefined){practice.ans[q.n]=+t.dataset.i;renderPractice(false);} return;}
    if(act==='prev'&&practice.i>0){practice.i--;return renderPractice();}
    if(act==='next'&&practice.i<49){practice.i++;return renderPractice();}
    if(act==='goto'){practice.i=+t.dataset.k;return renderPractice();}
    if(act==='psummary'){view='psummary';return renderPracticeSummary();}
    if(act==='preset'){if(confirm('Xóa toàn bộ câu trả lời và làm lại từ câu 1?')){practice={i:0,ans:{}};renderPractice();}return;}
  }
  /* test */
  if(view==='test'&&test&&!test.done){
    if(act==='pick'){test.ans[test.ids[test.i]]=+t.dataset.i;return renderTest(false);}
    if(act==='tprev'&&test.i>0){test.i--;return renderTest();}
    if(act==='tnext'&&test.i<TEST_N-1){test.i++;return renderTest();}
    if(act==='tgoto'){test.i=+t.dataset.k;return renderTest();}
    if(act==='submit'&&answeredCount()===TEST_N){return finishTest();}
  }
  if(view==='result'&&act==='filter'){reviewFilter=t.dataset.f;return renderResult();}
});
document.addEventListener('keydown',e=>{
  if(e.target.closest('input,textarea')||e.metaKey||e.ctrlKey||e.altKey) return;
  const n=['1','2','3','4'].indexOf(e.key);
  if(view==='practice'){
    const q=QUESTIONS[practice.i];
    if(n>=0&&practice.ans[q.n]===undefined){practice.ans[q.n]=n;renderPractice(false);}
    else if(e.key==='ArrowRight'&&practice.i<49){practice.i++;renderPractice();}
    else if(e.key==='ArrowLeft'&&practice.i>0){practice.i--;renderPractice();}
  } else if(view==='test'&&test&&!test.done){
    if(n>=0){test.ans[test.ids[test.i]]=n;renderTest(false);}
    else if(e.key==='ArrowRight'&&test.i<TEST_N-1){test.i++;renderTest();}
    else if(e.key==='ArrowLeft'&&test.i>0){test.i--;renderTest();}
  }
});
window.addEventListener('beforeunload',e=>{if(view==='test'&&test&&!test.done){e.preventDefault();e.returnValue='';}});
renderHome();
</script>
</body>
</html>
