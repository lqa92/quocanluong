function shuffle(a){for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function fmt(s){s=Math.max(0,Math.ceil(s));return String(Math.floor(s/60)).padStart(2,'0')+':'+String(s%60).padStart(2,'0');}
function top0(){window.scrollTo({top:0,behavior:'instant'});}

function qBlock(q,label,extra=''){
  return `<div class="qhead"><span class="qnum">${label}</span>${q.star?'<span class="star">★ Nâng cao</span>':''}${extra}</div>
  <div class="prompt">${q.p}</div>
  ${q.img?`<figure class="fig"><img src="${IMG[q.img]}" alt="그림"></figure>`:''}`;
}
function optsBlock(q,clsFn,disabled,tagFn=()=>''){
  const isImg=q.o[0].startsWith('IMG:');
  return `<div class="opts ${isImg?'g4':''}">`+q.o.map((o,i)=>{
    const body=o.startsWith('IMG:')?`<img src="${IMG[o.slice(4)]}" alt="그래프 ${CIRC[i]}">`:`<span>${o}${tagFn(i)}</span>`;
    return `<button class="opt ${isImg?'imgopt':''} ${clsFn(i)}" data-act="pick" data-i="${i}" ${disabled?'disabled':''}><span class="mark">${CIRC[i]}</span>${body}${isImg?tagFn(i):''}</button>`;
  }).join('')+'</div>';
}

