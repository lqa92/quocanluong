.pr .big{font-size:1.5rem; font-weight:800}
.pr .big small{font-size:.8rem; font-weight:500; color:var(--muted)}
input[type=range]{width:100%; height:28px; margin:4px 0 0}
#slEss{accent-color:var(--ess)} #slLux{accent-color:var(--lux)}
