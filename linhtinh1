&lt;script&gt;
(function(){
  const P0 = 50, Q0 = 100, PMIN = 30, PMAX_SL = 60;
  const qUp   = p =&gt; Math.max(0, (60 - p) / 0.1);   // đoạn trên: đối thủ không theo
  const qDown = p =&gt; Math.max(0, (90 - p) / 0.4);   // đoạn dưới: đối thủ theo
  const demandQ = p =&gt; p &gt;= P0 ? qUp(p) : qDown(p);

  let price = P0, mc = 25;

  const fmt = (n, d=1) =&gt; Number(n).toLocaleString(&#x27;vi-VN&#x27;, {maximumFractionDigits:d, minimumFractionDigits:0});
  const sgn = (n, d=1) =&gt; (n &gt; 0.0001 ? &#x27;+&#x27; : n &lt; -0.0001 ? &#x27;−&#x27; : &#x27;&#x27;) + fmt(Math.abs(n), d);
  const cls = n =&gt; n &gt; 0.0001 ? &#x27;pos&#x27; : n &lt; -0.0001 ? &#x27;neg&#x27; : &#x27;zero&#x27;;

  /* ---------- SVG ---------- */
  const NS = &#x27;http://www.w3.org/2000/svg&#x27;;
  const svg = document.getElementById(&#x27;chart&#x27;);
  const W = 640, H = 470, m = {l:62, r:22, t:22, b:58};
  const QM = 160, PM = 70;
  const xs = q =&gt; m.l + q / QM * (W - m.l - m.r);
  const ys = p =&gt; m.t + (1 - p / PM) * (H - m.t - m.b);
  function el(tag, a, parent){
    const e = document.createElementNS(NS, tag);
    for (const k in a) e.setAttribute(k, a[k]);
    (parent || svg).appendChild(e); return e;
  }
  const pts = arr =&gt; arr.map(([q,p]) =&gt; xs(q).toFixed(1)+&#x27;,&#x27;+ys(p).toFixed(1)).join(&#x27; &#x27;);

  const defs = el(&#x27;defs&#x27;, {});
  [[&#x27;arRaise&#x27;,&#x27;--raise&#x27;],[&#x27;arCut&#x27;,&#x27;--cut&#x27;]].forEach(([id, v]) =&gt; {
    const mk = el(&#x27;marker&#x27;, {id, viewBox:&#x27;0 0 10 10&#x27;, refX:&#x27;8&#x27;, refY:&#x27;5&#x27;, markerWidth:&#x27;7&#x27;, markerHeight:&#x27;7&#x27;, orient:&#x27;auto-start-reverse&#x27;}, defs);
    el(&#x27;path&#x27;, {d:&#x27;M0,0 L10,5 L0,10 z&#x27;, style:&#x27;fill:var(&#x27;+v+&#x27;)&#x27;}, mk);
  });

  // grid + ticks
  for (let q = 0; q &lt;= QM; q += 20){
    if (q) el(&#x27;line&#x27;, {x1:xs(q), y1:ys(0), x2:xs(q), y2:ys(PM), class:&#x27;g-grid&#x27;});
    el(&#x27;text&#x27;, {x:xs(q), y:ys(0)+18, &#x27;text-anchor&#x27;:&#x27;middle&#x27;, class:&#x27;g-tick&#x27;}).textContent = q;
  }
  for (let p = 0; p &lt;= PM; p += 10){
    if (p) el(&#x27;line&#x27;, {x1:xs(0), y1:ys(p), x2:xs(QM), y2:ys(p), class:&#x27;g-grid&#x27;});
    el(&#x27;text&#x27;, {x:xs(0)-8, y:ys(p)+4, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-tick&#x27;}).textContent = p;
  }
  el(&#x27;line&#x27;, {x1:xs(0), y1:ys(0), x2:xs(QM)+8, y2:ys(0), class:&#x27;g-axis&#x27;});
  el(&#x27;line&#x27;, {x1:xs(0), y1:ys(0), x2:xs(0), y2:ys(PM)-8, class:&#x27;g-axis&#x27;});
  el(&#x27;text&#x27;, {x:xs(QM), y:H-12, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-title&#x27;}).textContent = &#x27;Sản lượng Q (nghìn sp)&#x27;;
  el(&#x27;text&#x27;, {x:14, y:ys(PM/2), &#x27;text-anchor&#x27;:&#x27;middle&#x27;, class:&#x27;g-title&#x27;, transform:`rotate(-90 14 ${ys(PM/2)})`}).textContent = &#x27;Giá P (nghìn đ)&#x27;;

  // dynamic revenue rect (under curves)
  const revRect = el(&#x27;rect&#x27;, {class:&#x27;g-rev&#x27;});
  const revLbl  = el(&#x27;text&#x27;, {class:&#x27;g-lbl&#x27;}); revLbl.textContent = &#x27;Doanh thu = P × Q&#x27;;

  // MR / MC group
  const mrG = el(&#x27;g&#x27;, {style:&#x27;display:none&#x27;});
  el(&#x27;polyline&#x27;, {points:pts([[0,60],[100,40]]), class:&#x27;g-mr&#x27;}, mrG);
  el(&#x27;line&#x27;, {x1:xs(100), y1:ys(40), x2:xs(100), y2:ys(10), class:&#x27;g-mrgap&#x27;}, mrG);
  el(&#x27;polyline&#x27;, {points:pts([[100,10],[112.5,0]]), class:&#x27;g-mr&#x27;}, mrG);
  const mrL = el(&#x27;text&#x27;, {x:xs(22), y:ys(55.6)+18, class:&#x27;g-lbl&#x27;, style:&#x27;fill:var(--mr);font-weight:700&#x27;}, mrG); mrL.textContent = &#x27;MR&#x27;;
  const gapL = el(&#x27;text&#x27;, {x:xs(100)+8, y:ys(25), class:&#x27;g-lbl&#x27;, style:&#x27;fill:var(--mr)&#x27;}, mrG); gapL.textContent = &#x27;khoảng hở MR (10 → 40)&#x27;;
  const mcLine = el(&#x27;line&#x27;, {x1:xs(0), x2:xs(QM), class:&#x27;g-mc&#x27;}, mrG);
  const mcLbl = el(&#x27;text&#x27;, {x:xs(QM)-4, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-lbl&#x27;, style:&#x27;fill:var(--mc);font-weight:700&#x27;}, mrG);

  // counterfactual extensions
  el(&#x27;polyline&#x27;, {points:pts([[100,50],[160,44]]), class:&#x27;g-ext&#x27;});
  el(&#x27;polyline&#x27;, {points:pts([[75,60],[100,50]]), class:&#x27;g-ext&#x27;});
  const e1 = el(&#x27;text&#x27;, {x:xs(158), y:ys(44)-10, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-lbl&#x27;}); e1.textContent = &#x27;nếu đối thủ không giảm theo&#x27;;
  const e2 = el(&#x27;text&#x27;, {x:xs(75)+4, y:ys(60)-8, &#x27;text-anchor&#x27;:&#x27;middle&#x27;, class:&#x27;g-lbl&#x27;}); e2.textContent = &#x27;nếu đối thủ tăng theo&#x27;;

  // demand
  el(&#x27;polyline&#x27;, {points:pts([[0,60],[100,50],[150,30]]), class:&#x27;g-demand&#x27;});
  const d1 = el(&#x27;text&#x27;, {x:xs(3), y:ys(60)-14, class:&#x27;g-lbl-strong&#x27;}); d1.textContent = &#x27;Tăng giá: đối thủ không theo&#x27;;
  const d2 = el(&#x27;text&#x27;, {x:xs(117), y:ys(28), &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-lbl-strong&#x27;}); d2.textContent = &#x27;Giảm giá: đối thủ giảm theo&#x27;;

  // guides, deltas
  const gH = el(&#x27;line&#x27;, {class:&#x27;g-guide&#x27;}), gV = el(&#x27;line&#x27;, {class:&#x27;g-guide&#x27;});
  const dqLine = el(&#x27;line&#x27;, {&#x27;stroke-width&#x27;:2.5});
  const dqTxt  = el(&#x27;text&#x27;, {&#x27;text-anchor&#x27;:&#x27;middle&#x27;, class:&#x27;g-lbl&#x27;, style:&#x27;font-weight:700&#x27;});
  const dpLine = el(&#x27;line&#x27;, {&#x27;stroke-width&#x27;:2.5});
  const dpTxt  = el(&#x27;text&#x27;, {class:&#x27;g-lbl&#x27;, style:&#x27;font-weight:700&#x27;});

  // base point
  el(&#x27;circle&#x27;, {cx:xs(100), cy:ys(50), r:7, class:&#x27;g-base&#x27;});
  const baseL = el(&#x27;text&#x27;, {x:xs(100)-12, y:ys(50)+22, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-lbl&#x27;}); baseL.textContent = &#x27;E₀ (Q=100; P=50)&#x27;;

  // ghost (counterfactual) point
  const cfLink = el(&#x27;line&#x27;, {class:&#x27;g-guide&#x27;});
  const ghost = el(&#x27;circle&#x27;, {r:6, class:&#x27;g-ghost&#x27;});

  // current point
  const hit = el(&#x27;circle&#x27;, {r:26, class:&#x27;g-hit&#x27;});
  const pt  = el(&#x27;circle&#x27;, {r:10, class:&#x27;g-point&#x27;});
  const ptL = el(&#x27;text&#x27;, {class:&#x27;g-lbl-strong&#x27;});

  /* ---------- DOM ---------- */
  const $ = id =&gt; document.getElementById(id);
  const slider = $(&#x27;price&#x27;), mcSl = $(&#x27;mc&#x27;);

  function optimum(c){
    if (c &gt;= 10 &amp;&amp; c &lt;= 40) return {p:50, q:100, gap:true};
    if (c &lt; 10){ const q = (90 - c) / 0.8; return {p:90 - 0.4*q, q, gap:false}; }
    const q = Math.max(0, (60 - c) / 0.2); return {p:60 - 0.1*q, q, gap:false};
  }

  const scen = [
    [&#x27;Giảm 20%&#x27;, 40], [&#x27;Giảm 10%&#x27;, 45], [&#x27;Giảm 5%&#x27;, 47.5], [&#x27;Giữ giá&#x27;, 50],
    [&#x27;Tăng 5%&#x27;, 52.5], [&#x27;Tăng 10%&#x27;, 55], [&#x27;Tăng 15%&#x27;, 57.5]
  ];

  function render(){
    const p = price, q = demandQ(p);
    const TR = p*q, TR0 = P0*Q0, pi = (p-mc)*q, pi0 = (P0-mc)*Q0;
    const dPp = (p-P0)/P0*100, dQp = (q-Q0)/Q0*100;
    const up = p &gt; P0 + 1e-9, down = p &lt; P0 - 1e-9;
    const col = up ? &#x27;var(--raise)&#x27; : &#x27;var(--cut)&#x27;;

    // chart
    const x = xs(q), y = ys(p);
    revRect.setAttribute(&#x27;x&#x27;, xs(0)); revRect.setAttribute(&#x27;y&#x27;, y);
    revRect.setAttribute(&#x27;width&#x27;, Math.max(0, x - xs(0))); revRect.setAttribute(&#x27;height&#x27;, ys(0) - y);
    revLbl.setAttribute(&#x27;x&#x27;, xs(0)+24); revLbl.setAttribute(&#x27;y&#x27;, y+18);
    revLbl.style.display = q &gt; 45 ? &#x27;&#x27; : &#x27;none&#x27;;
    gH.setAttribute(&#x27;x1&#x27;, xs(0)); gH.setAttribute(&#x27;x2&#x27;, x); gH.setAttribute(&#x27;y1&#x27;, y); gH.setAttribute(&#x27;y2&#x27;, y);
    gV.setAttribute(&#x27;x1&#x27;, x); gV.setAttribute(&#x27;x2&#x27;, x); gV.setAttribute(&#x27;y1&#x27;, y); gV.setAttribute(&#x27;y2&#x27;, ys(0));
    [pt, hit].forEach(c =&gt; { c.setAttribute(&#x27;cx&#x27;, x); c.setAttribute(&#x27;cy&#x27;, y); });
    const right = x &lt; W - 170;
    ptL.setAttribute(&#x27;x&#x27;, right ? x+14 : x-14); ptL.setAttribute(&#x27;y&#x27;, y-14);
    ptL.setAttribute(&#x27;text-anchor&#x27;, right ? &#x27;start&#x27; : &#x27;end&#x27;);
    ptL.textContent = `P=${fmt(p)}; Q=${fmt(q)}`;
    baseL.style.display = (up || down) ? &#x27;&#x27; : &#x27;none&#x27;;

    const showD = up || down;
    [dqLine, dqTxt, dpLine, dpTxt].forEach(e =&gt; e.style.display = showD ? &#x27;&#x27; : &#x27;none&#x27;);
    if (showD){
      const yb = ys(0) - 14;
      dqLine.setAttribute(&#x27;x1&#x27;, xs(Q0)); dqLine.setAttribute(&#x27;x2&#x27;, x);
      dqLine.setAttribute(&#x27;y1&#x27;, yb); dqLine.setAttribute(&#x27;y2&#x27;, yb);
      dqLine.style.stroke = col; dqLine.setAttribute(&#x27;marker-end&#x27;, `url(#${up?&#x27;arRaise&#x27;:&#x27;arCut&#x27;})`);
      dqTxt.setAttribute(&#x27;x&#x27;, (xs(Q0)+x)/2); dqTxt.setAttribute(&#x27;y&#x27;, yb-8);
      dqTxt.style.fill = col; dqTxt.textContent = `ΔQ = ${sgn(q-Q0)}`;
      const xb = xs(0) + 12;
      dpLine.setAttribute(&#x27;x1&#x27;, xb); dpLine.setAttribute(&#x27;x2&#x27;, xb);
      dpLine.setAttribute(&#x27;y1&#x27;, ys(P0)); dpLine.setAttribute(&#x27;y2&#x27;, y);
      dpLine.style.stroke = col; dpLine.setAttribute(&#x27;marker-end&#x27;, `url(#${up?&#x27;arRaise&#x27;:&#x27;arCut&#x27;})`);
      dpTxt.setAttribute(&#x27;x&#x27;, xb+8); dpTxt.setAttribute(&#x27;y&#x27;, (ys(P0)+y)/2 + 4);
      dpTxt.style.fill = col; dpTxt.textContent = `ΔP = ${sgn(p-P0)}`;
      dpTxt.style.display = Math.abs(p-P0) &gt;= 2 ? &#x27;&#x27; : &#x27;none&#x27;;
    }

    // counterfactual
    const qcf = up ? qDown(p) : down ? qUp(p) : null;
    const showCf = qcf !== null &amp;&amp; qcf &lt;= QM;
    [ghost, cfLink].forEach(e =&gt; e.style.display = showCf ? &#x27;&#x27; : &#x27;none&#x27;);
    if (showCf){
      ghost.setAttribute(&#x27;cx&#x27;, xs(qcf)); ghost.setAttribute(&#x27;cy&#x27;, y); ghost.style.stroke = col;
      cfLink.setAttribute(&#x27;x1&#x27;, x); cfLink.setAttribute(&#x27;x2&#x27;, xs(qcf));
      cfLink.setAttribute(&#x27;y1&#x27;, y); cfLink.setAttribute(&#x27;y2&#x27;, y);
    }

    // MC line
    mcLine.setAttribute(&#x27;y1&#x27;, ys(mc)); mcLine.setAttribute(&#x27;y2&#x27;, ys(mc));
    mcLbl.setAttribute(&#x27;y&#x27;, ys(mc) - 6); mcLbl.textContent = `MC = ${mc}`;

    // readouts
    $(&#x27;priceOut&#x27;).textContent = fmt(p);
    slider.value = p;
    $(&#x27;lP&#x27;).textContent = fmt(p);   setD(&#x27;dP&#x27;, dPp, &#x27;%&#x27;);
    $(&#x27;lQ&#x27;).textContent = fmt(q);   setD(&#x27;dQ&#x27;, dQp, &#x27;%&#x27;);
    $(&#x27;lTR&#x27;).textContent = fmt(TR, 0); setD(&#x27;dTR&#x27;, TR-TR0, &#x27;&#x27;, 0);
    $(&#x27;lPi0&#x27;).textContent = fmt(pi0, 0);
    $(&#x27;lPi&#x27;).textContent = fmt(pi, 0); setD(&#x27;dPi&#x27;, pi-pi0, &#x27;&#x27;, 0);

    // verdict
    const v = $(&#x27;verdict&#x27;);
    v.className = &#x27;verdict&#x27; + (up ? &#x27; up&#x27; : down ? &#x27; down&#x27; : &#x27;&#x27;);
    const E = showD ? Math.abs(dQp/dPp) : 0;
    const piSent = pi &lt; pi0 - 0.5
      ? `Lợi nhuận giảm ${fmt(pi0-pi,0)} triệu đ so với giữ giá 50 → doanh nghiệp không có lý do đổi giá.`
      : pi &gt; pi0 + 0.5
        ? `Với MC = ${mc}, lợi nhuận lại tăng ${fmt(pi-pi0,0)} triệu đ — MC đã ra ngoài khoảng hở MR nên đổi giá theo hướng này có lợi.`
        : &#x27;&#x27;;
    if (up){
      $(&#x27;vTitle&#x27;).textContent = `Tăng giá ${fmt(dPp)}% → sản lượng giảm ${fmt(-dQp)}%`;
      $(&#x27;vText&#x27;).innerHTML = `Đối thủ &lt;b&gt;giữ nguyên giá&lt;/b&gt;, khách chuyển sang họ. Sản lượng giảm gấp &lt;b&gt;${fmt(E)} lần&lt;/b&gt; mức tăng giá, doanh thu ${TR&lt;TR0?&#x27;giảm&#x27;:&#x27;tăng&#x27;} ${fmt(Math.abs(TR-TR0),0)} triệu đ. ${piSent}`;
    } else if (down){
      $(&#x27;vTitle&#x27;).textContent = `Giảm giá ${fmt(-dPp)}% → sản lượng chỉ tăng ${fmt(dQp)}%`;
      $(&#x27;vText&#x27;).innerHTML = `Đối thủ &lt;b&gt;giảm giá theo&lt;/b&gt; để giữ thị phần, nên bạn không giành thêm được nhiều khách. Sản lượng chỉ tăng &lt;b&gt;${fmt(E)} lần&lt;/b&gt; mức giảm giá, doanh thu ${TR&lt;TR0?&#x27;giảm&#x27;:&#x27;chỉ tăng&#x27;} ${fmt(Math.abs(TR-TR0),0)} triệu đ. ${piSent}`;
    } else {
      $(&#x27;vTitle&#x27;).textContent = &#x27;Đang ở điểm gãy&#x27;;
      $(&#x27;vText&#x27;).innerHTML = &#x27;Phía trên điểm này đường cầu rất thoải (tăng giá là mất nhiều khách), phía dưới thì dốc (giảm giá cũng không bán thêm được bao nhiêu). Thử kéo chấm đen lên hoặc xuống.&#x27;;
    }

    // counterfactual text
    let cf;
    if (up){
      const c = qDown(p);
      cf = `Nếu đối thủ cũng tăng giá theo, ở giá ${fmt(p)} bạn vẫn bán được &lt;b&gt;${fmt(c)}&lt;/b&gt; nghìn sp (${sgn((c-Q0)/Q0*100)}%) thay vì ${fmt(q)}. Chính việc đối thủ đứng yên khiến tăng giá bị “phạt” nặng: chênh lệch ${fmt(c-q)} nghìn sp.`;
    } else if (down){
      const c = qUp(p);
      cf = `Nếu đối thủ không giảm theo, ở giá ${fmt(p)} bạn sẽ bán được &lt;b&gt;${fmt(c)}&lt;/b&gt; nghìn sp (${sgn((c-Q0)/Q0*100)}%) nhờ giành khách của họ. Nhưng họ giảm theo nên bạn chỉ bán ${fmt(q)} — mất ${fmt(c-q)} nghìn sp lẽ ra có được.`;
    } else {
      cf = &#x27;Đổi giá để xem: đường nét đứt trên đồ thị cho biết sản lượng nếu đối thủ phản ứng ngược với giả định của mô hình.&#x27;;
    }
    $(&#x27;cf&#x27;).innerHTML = cf;

    // MC text
    const o = optimum(mc);
    $(&#x27;mcOut&#x27;).textContent = mc;
    $(&#x27;mcText&#x27;).innerHTML = o.gap
      ? `MC nằm trong khoảng hở MR (10 → 40), nên giá tối ưu &lt;b&gt;vẫn là 50&lt;/b&gt;, Q = 100. Chi phí thay đổi trong khoảng này mà giá không đổi — đây là lý do giá trong độc quyền nhóm thường &lt;b&gt;cứng nhắc&lt;/b&gt;.`
      : `MC đã ra ngoài khoảng hở MR, giá tối ưu dịch sang &lt;b&gt;${fmt(o.p)}&lt;/b&gt; (Q = ${fmt(o.q)}), lợi nhuận tối đa ${fmt((o.p-mc)*o.q,0)} triệu đ.`;

    // scenarios
    const body = $(&#x27;scenBody&#x27;);
    body.innerHTML = &#x27;&#x27;;
    scen.forEach(([name, sp]) =&gt; {
      const sq = demandQ(sp), sdq = (sq-Q0)/Q0*100;
      const tr = document.createElement(&#x27;tr&#x27;);
      tr.tabIndex = 0;
      if (Math.abs(sp - p) &lt; 1e-9) tr.className = &#x27;active&#x27;;
      tr.innerHTML = `&lt;td&gt;&lt;span class=&quot;lbl&quot;&gt;${name}&lt;/span&gt;&lt;/td&gt;&lt;td&gt;${fmt(sp)}&lt;/td&gt;&lt;td&gt;${fmt(sq)}&lt;/td&gt;
        &lt;td class=&quot;${cls(sdq)}&quot;&gt;${sgn(sdq)}%&lt;/td&gt;&lt;td&gt;${fmt(sp*sq,0)}&lt;/td&gt;&lt;td&gt;${fmt((sp-mc)*sq,0)}&lt;/td&gt;`;
      const go = () =&gt; animateTo(sp);
      tr.addEventListener(&#x27;click&#x27;, go);
      tr.addEventListener(&#x27;keydown&#x27;, e =&gt; { if (e.key === &#x27;Enter&#x27; || e.key === &#x27; &#x27;){ e.preventDefault(); go(); }});
      body.appendChild(tr);
    });
  }

  function setD(id, n, unit, d=1){
    const e = $(id);
    e.className = cls(n);
    e.textContent = sgn(n, d) + unit;
  }

  const clampP = p =&gt; Math.min(PMAX_SL, Math.max(PMIN, p));
  function setPrice(p){ price = clampP(p); render(); }

  // animation for buttons
  let anim = null;
  const reduce = matchMedia(&#x27;(prefers-reduced-motion: reduce)&#x27;).matches;
  function animateTo(target){
    target = clampP(target);
    if (anim) cancelAnimationFrame(anim);
    if (reduce){ setPrice(target); return; }
    const from = price, t0 = performance.now(), dur = 450;
    const step = t =&gt; {
      const k = Math.min(1, (t - t0) / dur), e = 1 - Math.pow(1 - k, 3);
      price = from + (target - from) * e;
      if (k &gt;= 1) price = target;
      render();
      if (k &lt; 1) anim = requestAnimationFrame(step);
    };
    anim = requestAnimationFrame(step);
  }

  // drag on chart
  let dragging = false;
  function priceFromEvent(ev){
    const s = svg.createSVGPoint(); s.x = ev.clientX; s.y = ev.clientY;
    const loc = s.matrixTransform(svg.getScreenCTM().inverse());
    const p = PM * (1 - (loc.y - m.t) / (H - m.t - m.b));
    return Math.round(clampP(p) * 2) / 2;
  }
  svg.addEventListener(&#x27;pointerdown&#x27;, ev =&gt; {
    dragging = true; svg.classList.add(&#x27;dragging&#x27;);
    svg.setPointerCapture(ev.pointerId);
    if (anim) cancelAnimationFrame(anim);
    setPrice(priceFromEvent(ev));
    pt.setAttribute(&#x27;r&#x27;, 13);
  });
  svg.addEventListener(&#x27;pointermove&#x27;, ev =&gt; { if (dragging) setPrice(priceFromEvent(ev)); });
  const end = () =&gt; { dragging = false; svg.classList.remove(&#x27;dragging&#x27;); pt.setAttribute(&#x27;r&#x27;, 10); };
  svg.addEventListener(&#x27;pointerup&#x27;, end);
  svg.addEventListener(&#x27;pointercancel&#x27;, end);

  slider.addEventListener(&#x27;input&#x27;, () =&gt; { if (anim) cancelAnimationFrame(anim); setPrice(parseFloat(slider.value)); });
  document.querySelectorAll(&#x27;.btns button&#x27;).forEach(b =&gt;
    b.addEventListener(&#x27;click&#x27;, () =&gt; animateTo(P0 * (1 + parseFloat(b.dataset.pct)/100))));
