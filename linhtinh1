.ledger th:first-child,.ledger td:first-child{text-align:left; white-space:normal}
.ledger thead th{font-size:.78rem; color:var(--muted); font-weight:600}
.ledger td.now{font-weight:700}
.ledger tr.hl td{background:color-mix(in srgb,var(--profit) 9%,transparent)}
.pos{color:var(--profit)} .neg{color:var(--neg)} .zero{color:var(--muted)}
h2.sec{font-size:1.3rem; margin:0 0 4px}
.intro{color:var(--muted); margin:0 0 12px; max-width:75ch}
.cmp{display:grid; grid-template-columns:minmax(0,1.4fr) minmax(0,1fr); gap:22px; align-items:start}
@media (max-width:920px){.cmp{grid-template-columns:1fr}}
.legend{display:flex; gap:16px; flex-wrap:wrap; font-size:.84rem; color:var(--muted); margin-top:6px}
.legend i{display:inline-block; width:18px; height:4px; border-radius:2px; vertical-align:middle; margin-right:6px}
.legend i.box{height:12px; width:14px}
.takeaway{border-left:5px solid var(--gold); padding:4px 0 4px 14px}
.takeaway h3{margin:0 0 8px; font-size:1.05rem}
.takeaway p{margin:0 0 10px}
table.opt{width:100%; border-collapse:collapse; font-size:.92rem; margin:6px 0 12px}
.opt th,.opt td{padding:8px 6px; border-bottom:1px solid var(--rule); text-align:right}
.opt th:first-child,.opt td:first-child{text-align:left}
.opt thead th{font-size:.78rem; color:var(--muted); font-weight:600}
.notes{font-size:.9rem; color:var(--muted)}
.notes h3{color:var(--ink); font-size:1rem; margin:0 0 6px}
.notes ul{margin:0; padding-left:18px}
.notes code{font-family:inherit; font-weight:600; color:var(--ink)}
.g-grid{stroke:var(--grid)} .g-axis{stroke:var(--ink); stroke-width:1.5}
.g-tick{fill:var(--muted); font-size:12px} .g-title{fill:var(--ink); font-size:12.5px; font-weight:600}
.g-cost{fill:var(--cost-fill)} .g-profit{fill:var(--profit-fill)}
.g-mc{stroke:var(--mc); stroke-width:2; stroke-dasharray:7 5}
.g-mr{fill:none; stroke:var(--mr); stroke-width:2.5}
.g-guide{stroke:var(--muted); stroke-width:1.2; stroke-dasharray:4 4}
.g-lbl{font-size:12px; fill:var(--muted); paint-order:stroke; stroke:var(--sheet); stroke-width:4px; stroke-linejoin:round}
.g-lbl-b{font-size:13px; font-weight:700; fill:var(--ink); paint-order:stroke; stroke:var(--sheet); stroke-width:4px; stroke-linejoin:round}
.g-base{fill:var(--sheet); stroke:var(--ink); stroke-width:2}
.g-pt{fill:var(--ink); stroke:var(--sheet); stroke-width:3; cursor:grab}
.g-opt{fill:var(--sheet); stroke:var(--mr); stroke-width:2.5}
