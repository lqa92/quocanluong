"></iframe>
<script>
(function(){
  const tabs = [...document.querySelectorAll('.tab')];
  const frames = {'tab-mono':document.getElementById('panel-mono'), 'tab-olig':document.getElementById('panel-olig')};
  function fit(f){
    try{
      const b = f.contentDocument && f.contentDocument.body;
      if (b) f.style.height = Math.ceil(b.getBoundingClientRect().height) + 'px';
    }catch(e){}
  }
  Object.values(frames).forEach(f => {
    f.addEventListener('load', () => {
      fit(f);
      try{
        const b = f.contentDocument.body;
        if ('ResizeObserver' in window) new ResizeObserver(() => fit(f)).observe(b);
        f.contentDocument.fonts && f.contentDocument.fonts.ready.then(() => fit(f));
      }catch(e){}
    });
  });
  function show(id, focus){
    tabs.forEach(t => {
      const on = t.id === id;
      t.setAttribute('aria-selected', on);
      t.tabIndex = on ? 0 : -1;
      frames[t.id].hidden = !on;
    });
    fit(frames[id]);
    if (focus) document.getElementById(id).focus();
    window.scrollTo({top:0});
  }
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => show(t.id));
    t.addEventListener('keydown', e => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft'){
        e.preventDefault();
        const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        show(n.id, true);
      }
    });
  });
  window.addEventListener('resize', () => Object.values(frames).forEach(f => { if (!f.hidden) fit(f); }));
  if (location.hash === '#doc-quyen-nhom') show('tab-olig');
})();
</script>
