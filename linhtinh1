<style>
:root{
  --paper:#f2f5f8; --sheet:#ffffff; --ink:#1d2a3a; --muted:#5d6b7c; --rule:#d6dee7; --gold:#cf9a5f;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --paper:#121821; --sheet:#1a222d; --ink:#e8eef5; --muted:#9aa8b8; --rule:#2e3a48; --gold:#e2ad70;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --paper:#121821; --sheet:#1a222d; --ink:#e8eef5; --muted:#9aa8b8; --rule:#2e3a48; --gold:#e2ad70;
}
*,*::before,*::after{box-sizing:border-box}
body{margin:0; background:var(--paper); color:var(--ink);
  font-family:'Be Vietnam Pro',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif; font-size:16px; line-height:1.5}
.topbar{position:sticky; top:env(safe-area-inset-top,0px); z-index:10; background:var(--paper);
  border-bottom:1px solid var(--rule)}
.topbar-in{max-width:1200px; margin:0 auto; padding:14px 20px 0; display:flex; flex-wrap:wrap; align-items:flex-end; justify-content:space-between; gap:8px 20px}
.brand{padding-bottom:12px}
.brand b{display:block; font-size:1.05rem; font-weight:800; letter-spacing:-.01em}
.brand span{font-size:.85rem; color:var(--muted)}
.tabs{display:flex; gap:4px}
.tab{font:inherit; font-size:.98rem; font-weight:700; cursor:pointer; background:transparent; color:var(--muted);
  border:0; border-bottom:3px solid transparent; padding:10px 16px 11px; border-radius:8px 8px 0 0}
.tab:hover{color:var(--ink)}
.tab[aria-selected="true"]{color:var(--ink); border-bottom-color:var(--gold); background:var(--sheet)}
.tab:focus-visible{outline:3px solid var(--gold); outline-offset:-3px}
.tab small{display:block; font-size:.75rem; font-weight:500; color:var(--muted)}
iframe{display:block; width:100%; border:0; height:1400px}
[hidden]{display:none!important}
</style>
</head>
