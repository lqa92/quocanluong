&lt;body&gt;
&lt;main class=&quot;wrap&quot;&gt;
  &lt;header&gt;
    &lt;h1&gt;Sức mạnh độc quyền: hàng thiết yếu và hàng xa xỉ&lt;/h1&gt;
    &lt;p class=&quot;lead&quot;&gt;Cùng một doanh nghiệp độc quyền (người bán duy nhất trên thị trường). Giả định doanh nghiệp này bán một trong hai loại mặt hàng: &lt;span class=&quot;e&quot;&gt;hàng thiết yếu&lt;/span&gt; với đường cầu &lt;b&gt;dốc&lt;/b&gt;, hoặc &lt;span class=&quot;l&quot;&gt;hàng xa xỉ&lt;/span&gt; với đường cầu &lt;b&gt;thoải&lt;/b&gt;. Ở cả hai tình huống, doanh nghiệp đang bán ở giá &lt;b&gt;50 nghìn đ&lt;/b&gt;, bán được &lt;b&gt;100 nghìn sp&lt;/b&gt;, chi phí biên (MC) là &lt;b&gt;20 nghìn đ/sp&lt;/b&gt;. Khác biệt duy nhất là độ dốc của đường cầu. Kéo chấm đen trên đồ thị hoặc thanh trượt để thay đổi giá.&lt;/p&gt;
  &lt;/header&gt;

  &lt;section class=&quot;sheet&quot;&gt;
    &lt;div class=&quot;bar&quot;&gt;
      &lt;div class=&quot;btns&quot;&gt;
        &lt;button type=&quot;button&quot; data-set=&quot;50&quot;&gt;Về giá 50&lt;/button&gt;
        &lt;button type=&quot;button&quot; data-set=&quot;60&quot;&gt;Tăng lên 60&lt;/button&gt;
        &lt;button type=&quot;button&quot; data-set=&quot;75&quot;&gt;Tăng lên 75&lt;/button&gt;
        &lt;button type=&quot;button&quot; data-set=&quot;40&quot;&gt;Giảm xuống 40&lt;/button&gt;
        &lt;button type=&quot;button&quot; data-set=&quot;opt&quot; class=&quot;primary&quot;&gt;Đặt giá có lợi nhất cho từng mặt hàng&lt;/button&gt;
      &lt;/div&gt;
      &lt;label class=&quot;toggle&quot;&gt;&lt;input type=&quot;checkbox&quot; id=&quot;link&quot; checked&gt; Đặt cùng một mức giá cho cả hai tình huống&lt;/label&gt;
      &lt;label class=&quot;toggle&quot;&gt;&lt;input type=&quot;checkbox&quot; id=&quot;showMR&quot;&gt; Hiện doanh thu biên (MR) và điểm tối ưu&lt;/label&gt;
    &lt;/div&gt;
  &lt;/section&gt;

  &lt;div class=&quot;duo&quot;&gt;
    &lt;section class=&quot;sheet&quot; id=&quot;card-ess&quot;&gt;
      &lt;div class=&quot;card-h&quot;&gt;
        &lt;div&gt;&lt;h2 class=&quot;e&quot;&gt;Tình huống 1: Hàng thiết yếu&lt;/h2&gt;&lt;p&gt;Ví dụ: điện, nước sạch, thuốc đặc trị&lt;/p&gt;&lt;/div&gt;
        &lt;span class=&quot;pill ess&quot;&gt;Đường cầu dốc&lt;/span&gt;
      &lt;/div&gt;
      &lt;svg id=&quot;chEss&quot; class=&quot;drag&quot; viewBox=&quot;0 0 540 410&quot; role=&quot;img&quot; aria-label=&quot;Đồ thị cầu hàng thiết yếu&quot;&gt;&lt;/svg&gt;
      &lt;div class=&quot;pr&quot;&gt;&lt;label for=&quot;slEss&quot;&gt;Giá bán&lt;/label&gt;&lt;span class=&quot;big&quot;&gt;&lt;span id=&quot;pEss&quot;&gt;50&lt;/span&gt; &lt;small&gt;nghìn đ&lt;/small&gt;&lt;/span&gt;&lt;/div&gt;
      &lt;input type=&quot;range&quot; id=&quot;slEss&quot; min=&quot;20&quot; max=&quot;100&quot; step=&quot;1&quot; value=&quot;50&quot;&gt;
      &lt;div class=&quot;verdict&quot; id=&quot;vEss&quot; aria-live=&quot;polite&quot;&gt;&lt;/div&gt;
      &lt;div class=&quot;table-wrap&quot;&gt;&lt;table class=&quot;ledger&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Giá 50&lt;/th&gt;&lt;th&gt;Hiện tại&lt;/th&gt;&lt;th&gt;Thay đổi&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody id=&quot;tEss&quot;&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
    &lt;/section&gt;

    &lt;section class=&quot;sheet&quot; id=&quot;card-lux&quot;&gt;
      &lt;div class=&quot;card-h&quot;&gt;
        &lt;div&gt;&lt;h2 class=&quot;l&quot;&gt;Tình huống 2: Hàng xa xỉ&lt;/h2&gt;&lt;p&gt;Ví dụ: túi hàng hiệu, du lịch cao cấp&lt;/p&gt;&lt;/div&gt;
        &lt;span class=&quot;pill lux&quot;&gt;Đường cầu thoải&lt;/span&gt;
      &lt;/div&gt;
      &lt;svg id=&quot;chLux&quot; class=&quot;drag&quot; viewBox=&quot;0 0 540 410&quot; role=&quot;img&quot; aria-label=&quot;Đồ thị cầu hàng xa xỉ&quot;&gt;&lt;/svg&gt;
      &lt;div class=&quot;pr&quot;&gt;&lt;label for=&quot;slLux&quot;&gt;Giá bán&lt;/label&gt;&lt;span class=&quot;big&quot;&gt;&lt;span id=&quot;pLux&quot;&gt;50&lt;/span&gt; &lt;small&gt;nghìn đ&lt;/small&gt;&lt;/span&gt;&lt;/div&gt;
      &lt;input type=&quot;range&quot; id=&quot;slLux&quot; min=&quot;20&quot; max=&quot;100&quot; step=&quot;1&quot; value=&quot;50&quot;&gt;
      &lt;div class=&quot;verdict&quot; id=&quot;vLux&quot; aria-live=&quot;polite&quot;&gt;&lt;/div&gt;
      &lt;div class=&quot;table-wrap&quot;&gt;&lt;table class=&quot;ledger&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Giá 50&lt;/th&gt;&lt;th&gt;Hiện tại&lt;/th&gt;&lt;th&gt;Thay đổi&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody id=&quot;tLux&quot;&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
    &lt;/section&gt;
  &lt;/div&gt;

  &lt;section class=&quot;sheet&quot;&gt;
    &lt;h2 class=&quot;sec&quot;&gt;So sánh: lợi nhuận ở từng mức giá&lt;/h2&gt;
    &lt;p class=&quot;intro&quot;&gt;Đường cong cho biết doanh nghiệp kiếm được bao nhiêu ở từng mức giá, với mỗi loại mặt hàng. Đỉnh của đường cong là mức giá có lợi nhất.&lt;/p&gt;
    &lt;div class=&quot;cmp&quot;&gt;
      &lt;div&gt;
        &lt;svg id=&quot;chProfit&quot; viewBox=&quot;0 0 640 320&quot; role=&quot;img&quot; aria-label=&quot;Lợi nhuận theo mức giá của hai mặt hàng&quot;&gt;&lt;/svg&gt;
        &lt;div class=&quot;legend&quot;&gt;
          &lt;span&gt;&lt;i style=&quot;background:var(--ess)&quot;&gt;&lt;/i&gt;Hàng thiết yếu&lt;/span&gt;
          &lt;span&gt;&lt;i style=&quot;background:var(--lux)&quot;&gt;&lt;/i&gt;Hàng xa xỉ&lt;/span&gt;
          &lt;span&gt;&lt;i style=&quot;background:var(--mr)&quot;&gt;&lt;/i&gt;Đỉnh lợi nhuận&lt;/span&gt;
        &lt;/div&gt;
      &lt;/div&gt;
      &lt;div class=&quot;takeaway&quot;&gt;
        &lt;h3&gt;Mức giá có lợi nhất cho từng mặt hàng&lt;/h3&gt;
        &lt;div class=&quot;table-wrap&quot;&gt;&lt;table class=&quot;opt&quot;&gt;
          &lt;thead&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Giá&lt;/th&gt;&lt;th&gt;Lượng bán&lt;/th&gt;&lt;th&gt;Giá cao hơn chi phí&lt;/th&gt;&lt;th&gt;Lợi nhuận&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
          &lt;tbody id=&quot;optBody&quot;&gt;&lt;/tbody&gt;
        &lt;/table&gt;&lt;/div&gt;
        &lt;p id=&quot;insight&quot;&gt;&lt;/p&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  &lt;/section&gt;

  &lt;section class=&quot;sheet&quot;&gt;
    &lt;h2 class=&quot;sec&quot;&gt;Chú thích đồ thị&lt;/h2&gt;
    &lt;div class=&quot;legend&quot; style=&quot;margin-bottom:10px&quot;&gt;
      &lt;span&gt;&lt;i class=&quot;box&quot; style=&quot;background:var(--profit-fill);outline:1px solid var(--profit)&quot;&gt;&lt;/i&gt;Lợi nhuận = (P − MC) × Q&lt;/span&gt;
      &lt;span&gt;&lt;i class=&quot;box&quot; style=&quot;background:var(--cost-fill)&quot;&gt;&lt;/i&gt;Chi phí sản xuất = MC × Q&lt;/span&gt;
      &lt;span&gt;&lt;i style=&quot;background:repeating-linear-gradient(90deg,var(--mc) 0 6px,transparent 6px 10px)&quot;&gt;&lt;/i&gt;Chi phí biên MC = 20&lt;/span&gt;
      &lt;span&gt;&lt;i style=&quot;background:var(--mr)&quot;&gt;&lt;/i&gt;Doanh thu biên MR&lt;/span&gt;
    &lt;/div&gt;
    &lt;div class=&quot;notes&quot;&gt;
      &lt;h3&gt;Số liệu giả định&lt;/h3&gt;
      &lt;ul&gt;
        &lt;li&gt;Hàng thiết yếu: &lt;code&gt;P = 150 − Q&lt;/code&gt;. Giá tăng 1 nghìn đ thì người mua chỉ bớt 1 nghìn sp, vì dù đắt họ vẫn cần dùng.&lt;/li&gt;
        &lt;li&gt;Hàng xa xỉ: &lt;code&gt;P = 70 − 0,2Q&lt;/code&gt;. Giá tăng 1 nghìn đ thì người mua bớt tới 5 nghìn sp, vì họ dễ dàng không mua nữa hoặc chuyển sang thứ khác.&lt;/li&gt;
        &lt;li&gt;Cả hai đường cầu cùng đi qua điểm P = 50, Q = 100 để so sánh công bằng. MC = 20 nghìn đ/sp, bỏ qua chi phí cố định.&lt;/li&gt;
        &lt;li&gt;Đơn vị: giá nghìn đ, lượng nghìn sp, doanh thu và lợi nhuận triệu đ.&lt;/li&gt;
      &lt;/ul&gt;
    &lt;/div&gt;
  &lt;/section&gt;
&lt;/main&gt;

&lt;script&gt;
(function(){
  const MC = 20, P0 = 50, PMIN = 20, PMAX = 100;
  const SC = {
    ess:{key:&#x27;ess&#x27;, a:150, b:1,   col:&#x27;--ess&#x27;, svg:&#x27;chEss&#x27;, sl:&#x27;slEss&#x27;, out:&#x27;pEss&#x27;, v:&#x27;vEss&#x27;, t:&#x27;tEss&#x27;},
    lux:{key:&#x27;lux&#x27;, a:70,  b:0.2, col:&#x27;--lux&#x27;, svg:&#x27;chLux&#x27;, sl:&#x27;slLux&#x27;, out:&#x27;pLux&#x27;, v:&#x27;vLux&#x27;, t:&#x27;tLux&#x27;}
  };
  const Qd = (s,p) =&gt; Math.max(0, (s.a - p) / s.b);
  const profit = (s,p) =&gt; (p - MC) * Qd(s,p);
  const opt = s =&gt; ({p:(s.a + MC)/2, q:(s.a - MC)/(2*s.b)});
  const price = {ess:P0, lux:P0};
  let linked = true, showMR = false;

  const $ = id =&gt; document.getElementById(id);
  const fmt = (n,d=1) =&gt; Number(n).toLocaleString(&#x27;vi-VN&#x27;, {maximumFractionDigits:d});
  const sgn = (n,d=1) =&gt; (n &gt; 0.0001 ? &#x27;+&#x27; : n &lt; -0.0001 ? &#x27;−&#x27; : &#x27;&#x27;) + fmt(Math.abs(n), d);
  const cls = n =&gt; n &gt; 0.0001 ? &#x27;pos&#x27; : n &lt; -0.0001 ? &#x27;neg&#x27; : &#x27;zero&#x27;;
  const NS = &#x27;http://www.w3.org/2000/svg&#x27;;
  function el(tag, a, parent){ const e = document.createElementNS(NS, tag); for (const k in a) e.setAttribute(k, a[k]); parent.appendChild(e); return e; }

  /* ---------- per-product chart ---------- */
  const W = 540, H = 410, m = {l:54, r:16, t:16, b:48}, QM = 260, PM = 160;
  const xs = q =&gt; m.l + q/QM * (W - m.l - m.r);
  const ys = p =&gt; m.t + (1 - p/PM) * (H - m.t - m.b);

  function buildChart(s){
    const svg = $(s.svg);
    for (let q = 0; q &lt;= QM; q += 40){
      if (q) el(&#x27;line&#x27;, {x1:xs(q), x2:xs(q), y1:ys(0), y2:ys(PM), class:&#x27;g-grid&#x27;}, svg);
      el(&#x27;text&#x27;, {x:xs(q), y:ys(0)+18, &#x27;text-anchor&#x27;:&#x27;middle&#x27;, class:&#x27;g-tick&#x27;}, svg).textContent = q;
    }
    for (let p = 0; p &lt;= PM; p += 20){
      if (p) el(&#x27;line&#x27;, {x1:xs(0), x2:xs(QM), y1:ys(p), y2:ys(p), class:&#x27;g-grid&#x27;}, svg);
      el(&#x27;text&#x27;, {x:xs(0)-8, y:ys(p)+4, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-tick&#x27;}, svg).textContent = p;
    }
    el(&#x27;text&#x27;, {x:xs(QM), y:H-10, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-title&#x27;}, svg).textContent = &#x27;Lượng cầu Q (nghìn sp)&#x27;;
    el(&#x27;text&#x27;, {x:14, y:ys(PM/2), &#x27;text-anchor&#x27;:&#x27;middle&#x27;, class:&#x27;g-title&#x27;, transform:`rotate(-90 14 ${ys(PM/2)})`}, svg).textContent = &#x27;Giá P (nghìn đ)&#x27;;

    const r = {};
    r.cost = el(&#x27;rect&#x27;, {class:&#x27;g-cost&#x27;}, svg);
    r.prof = el(&#x27;rect&#x27;, {class:&#x27;g-profit&#x27;}, svg);
    r.profL = el(&#x27;text&#x27;, {class:&#x27;g-lbl&#x27;, &#x27;text-anchor&#x27;:&#x27;middle&#x27;, style:&#x27;fill:var(--profit);font-weight:700&#x27;}, svg);

    el(&#x27;line&#x27;, {x1:xs(0), y1:ys(0), x2:xs(QM)+6, y2:ys(0), class:&#x27;g-axis&#x27;}, svg);
    el(&#x27;line&#x27;, {x1:xs(0), y1:ys(0), x2:xs(0), y2:ys(PM)-6, class:&#x27;g-axis&#x27;}, svg);

    el(&#x27;line&#x27;, {x1:xs(0), x2:xs(QM), y1:ys(MC), y2:ys(MC), class:&#x27;g-mc&#x27;}, svg);
    el(&#x27;text&#x27;, {x:xs(QM)-2, y:ys(MC)-7, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-lbl&#x27;, style:&#x27;fill:var(--ink);font-weight:700&#x27;}, svg).textContent = &#x27;MC = 20&#x27;;

    r.mrG = el(&#x27;g&#x27;, {style:&#x27;display:none&#x27;}, svg);
    const qMR0 = Math.min(QM, s.a/(2*s.b));
    el(&#x27;polyline&#x27;, {points:`${xs(0)},${ys(s.a)} ${xs(qMR0)},${ys(s.a - 2*s.b*qMR0)}`, class:&#x27;g-mr&#x27;}, r.mrG);
    const o = opt(s);
    el(&#x27;line&#x27;, {x1:xs(o.q), x2:xs(o.q), y1:ys(o.p), y2:ys(MC), style:&#x27;stroke:var(--mr);stroke-width:1.5;stroke-dasharray:3 3&#x27;}, r.mrG);
    el(&#x27;circle&#x27;, {cx:xs(o.q), cy:ys(MC), r:4, style:&#x27;fill:var(--mr)&#x27;}, r.mrG);
    el(&#x27;circle&#x27;, {cx:xs(o.q), cy:ys(o.p), r:7, class:&#x27;g-opt&#x27;}, r.mrG);
    el(&#x27;text&#x27;, {x:xs(o.q)+12, y:ys(o.p)-10, class:&#x27;g-lbl&#x27;, style:&#x27;fill:var(--mr);font-weight:700&#x27;}, r.mrG).textContent = `Tối ưu: P = ${fmt(o.p)}`;
    const mrLblQ = s.key === &#x27;ess&#x27; ? 30 : 95;
    el(&#x27;text&#x27;, {x:xs(mrLblQ)+6, y:ys(s.a - 2*s.b*mrLblQ)+16, class:&#x27;g-lbl&#x27;, style:&#x27;fill:var(--mr);font-weight:700&#x27;}, r.mrG).textContent = &#x27;MR&#x27;;

    const qEnd = Math.min(QM, s.a/s.b);
    el(&#x27;line&#x27;, {x1:xs(0), y1:ys(s.a), x2:xs(qEnd), y2:ys(s.a - s.b*qEnd), style:`stroke:var(${s.col});stroke-width:6;stroke-linecap:round`}, svg);
    if (s.key === &#x27;ess&#x27;) el(&#x27;text&#x27;, {x:xs(18), y:ys(150-18)-4, class:&#x27;g-lbl-b&#x27;, style:&#x27;fill:var(--ess)&#x27;}, svg).textContent = &#x27;D: đường cầu dốc&#x27;;
    else el(&#x27;text&#x27;, {x:xs(250), y:ys(70-0.2*250)-12, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-lbl-b&#x27;, style:&#x27;fill:var(--lux)&#x27;}, svg).textContent = &#x27;D: đường cầu thoải&#x27;;

    r.gH = el(&#x27;line&#x27;, {class:&#x27;g-guide&#x27;}, svg); r.gV = el(&#x27;line&#x27;, {class:&#x27;g-guide&#x27;}, svg);
    r.dq = el(&#x27;line&#x27;, {&#x27;stroke-width&#x27;:2.5, style:`stroke:var(${s.col})`}, svg);
    r.dqT = el(&#x27;text&#x27;, {&#x27;text-anchor&#x27;:&#x27;middle&#x27;, class:&#x27;g-lbl&#x27;, style:`fill:var(${s.col});font-weight:700`}, svg);
    el(&#x27;circle&#x27;, {cx:xs(100), cy:ys(P0), r:6, class:&#x27;g-base&#x27;}, svg);
    r.hit = el(&#x27;circle&#x27;, {r:26, fill:&#x27;transparent&#x27;, style:&#x27;cursor:grab&#x27;}, svg);
    r.pt = el(&#x27;circle&#x27;, {r:9.5, class:&#x27;g-pt&#x27;}, svg);
    r.ptL = el(&#x27;text&#x27;, {class:&#x27;g-lbl-b&#x27;}, svg);

    let drag = false;
    const fromEv = ev =&gt; {
      const pt = svg.createSVGPoint(); pt.x = ev.clientX; pt.y = ev.clientY;
      const loc = pt.matrixTransform(svg.getScreenCTM().inverse());
      return Math.round(Math.min(PMAX, Math.max(PMIN, PM * (1 - (loc.y - m.t) / (H - m.t - m.b)))));
    };
    svg.addEventListener(&#x27;pointerdown&#x27;, ev =&gt; { drag = true; svg.setPointerCapture(ev.pointerId); stopAnim(); setPrice(s.key, fromEv(ev)); });
    svg.addEventListener(&#x27;pointermove&#x27;, ev =&gt; { if (drag) setPrice(s.key, fromEv(ev)); });
    svg.addEventListener(&#x27;pointerup&#x27;, () =&gt; drag = false);
    svg.addEventListener(&#x27;pointercancel&#x27;, () =&gt; drag = false);
    s.r = r;
  }

  function updateChart(s){
    const r = s.r, p = price[s.key], q = Qd(s,p), x = xs(q), y = ys(p);
    r.cost.setAttribute(&#x27;x&#x27;, xs(0)); r.cost.setAttribute(&#x27;y&#x27;, ys(MC)); r.cost.setAttribute(&#x27;width&#x27;, x - xs(0)); r.cost.setAttribute(&#x27;height&#x27;, ys(0) - ys(MC));
    r.prof.setAttribute(&#x27;x&#x27;, xs(0)); r.prof.setAttribute(&#x27;y&#x27;, y); r.prof.setAttribute(&#x27;width&#x27;, x - xs(0)); r.prof.setAttribute(&#x27;height&#x27;, Math.max(0, ys(MC) - y));
    const showPL = q &gt; 30 &amp;&amp; p - MC &gt; 14;
    r.profL.style.display = showPL ? &#x27;&#x27; : &#x27;none&#x27;;
    r.profL.setAttribute(&#x27;x&#x27;, (xs(0) + x)/2 + 10); r.profL.setAttribute(&#x27;y&#x27;, (y + ys(MC))/2 + 4);
    r.profL.textContent = `Lợi nhuận ${fmt(profit(s,p),0)}`;
    r.gH.setAttribute(&#x27;x1&#x27;, xs(0)); r.gH.setAttribute(&#x27;x2&#x27;, x); r.gH.setAttribute(&#x27;y1&#x27;, y); r.gH.setAttribute(&#x27;y2&#x27;, y);
    r.gV.setAttribute(&#x27;x1&#x27;, x); r.gV.setAttribute(&#x27;x2&#x27;, x); r.gV.setAttribute(&#x27;y1&#x27;, y); r.gV.setAttribute(&#x27;y2&#x27;, ys(0));
    const moved = Math.abs(q - 100) &gt; 0.5;
    r.dq.style.display = r.dqT.style.display = moved ? &#x27;&#x27; : &#x27;none&#x27;;
    if (moved){
      const yb = ys(0) - 12;
      r.dq.setAttribute(&#x27;x1&#x27;, xs(100)); r.dq.setAttribute(&#x27;x2&#x27;, x); r.dq.setAttribute(&#x27;y1&#x27;, yb); r.dq.setAttribute(&#x27;y2&#x27;, yb);
      r.dqT.setAttribute(&#x27;x&#x27;, (xs(100) + x)/2); r.dqT.setAttribute(&#x27;y&#x27;, yb - 7);
      r.dqT.textContent = `ΔQ = ${sgn(q - 100)}`;
    }
    [r.pt, r.hit].forEach(c =&gt; { c.setAttribute(&#x27;cx&#x27;, x); c.setAttribute(&#x27;cy&#x27;, y); });
    const right = x &lt; W - 170;
    r.ptL.setAttribute(&#x27;x&#x27;, right ? x + 14 : x - 14); r.ptL.setAttribute(&#x27;y&#x27;, y - 14);
    r.ptL.setAttribute(&#x27;text-anchor&#x27;, right ? &#x27;start&#x27; : &#x27;end&#x27;);
    r.ptL.textContent = q &gt; 0 ? `P = ${fmt(p)}; Q = ${fmt(q)}` : `P = ${fmt(p)}: không ai mua`;
    r.mrG.style.display = showMR ? &#x27;&#x27; : &#x27;none&#x27;;

    $(s.out).textContent = fmt(p);
    $(s.sl).value = Math.round(p);
    const q0 = 100, tr = p*q, tr0 = P0*q0, pi = profit(s,p), pi0 = (P0-MC)*q0;
    const rows = [
      [&#x27;Giá (nghìn đ)&#x27;, P0, p, p - P0, 1, &#x27;price&#x27;],
      [&#x27;Lượng cầu (nghìn sp)&#x27;, q0, q, q - q0, 1, &#x27;&#x27;],
      [&#x27;Doanh thu (triệu đ)&#x27;, tr0, tr, tr - tr0, 0, &#x27;&#x27;],
      [&#x27;Chi phí sản xuất (triệu đ)&#x27;, MC*q0, MC*q, MC*(q - q0), 0, &#x27;cost&#x27;],
      [&#x27;Lợi nhuận (triệu đ)&#x27;, pi0, pi, pi - pi0, 0, &#x27;hl&#x27;]
    ];
    $(s.t).innerHTML = rows.map(([n, a, b, d, dg, kind]) =&gt; {
      let dc = cls(d);
      if (kind === &#x27;cost&#x27;) dc = d &gt; 0.0001 ? &#x27;neg&#x27; : d &lt; -0.0001 ? &#x27;pos&#x27; : &#x27;zero&#x27;;
      if (kind === &#x27;price&#x27;) dc = &#x27;zero&#x27;;
      return `&lt;tr class=&quot;${kind===&#x27;hl&#x27;?&#x27;hl&#x27;:&#x27;&#x27;}&quot;&gt;&lt;td&gt;${n}&lt;/td&gt;&lt;td&gt;${fmt(a,dg)}&lt;/td&gt;&lt;td class=&quot;now&quot;&gt;${fmt(b,dg)}&lt;/td&gt;&lt;td class=&quot;${dc}&quot;&gt;${sgn(d,dg)}&lt;/td&gt;&lt;/tr&gt;`;
    }).join(&#x27;&#x27;);

    let v;
    const dP = (p - P0)/P0*100, dQ = (q - q0)/q0*100;
    if (Math.abs(p - P0) &lt; 0.01) v = &#x27;Đang ở giá ban đầu. Kéo giá lên hoặc xuống để xem người mua phản ứng thế nào.&#x27;;
    else if (q &lt;= 0) v = `Giá ${fmt(p)}: &lt;b&gt;không còn ai mua&lt;/b&gt;. Người mua bỏ hẳn khi giá quá cao, doanh thu và lợi nhuận về 0.`;
    else if (p &gt; P0) v = `Tăng giá ${fmt(dP)}% → lượng cầu giảm &lt;b&gt;${fmt(-dQ)}%&lt;/b&gt;. ` + (pi &gt; pi0
      ? `Người mua vẫn cần dùng nên phần lớn vẫn mua, lợi nhuận &lt;b class=&quot;pos&quot;&gt;tăng ${fmt(pi-pi0,0)}&lt;/b&gt; triệu đ.`
      : `Người mua bỏ đi rất nhiều, lợi nhuận &lt;b class=&quot;neg&quot;&gt;giảm ${fmt(pi0-pi,0)}&lt;/b&gt; triệu đ.`);
    else v = `Giảm giá ${fmt(-dP)}% → lượng cầu tăng &lt;b&gt;${fmt(dQ)}%&lt;/b&gt;. ` + (pi &gt; pi0
      ? `Hút thêm được nhiều người mua, lợi nhuận &lt;b class=&quot;pos&quot;&gt;tăng ${fmt(pi-pi0,0)}&lt;/b&gt; triệu đ.`
      : s.key === &#x27;ess&#x27;
        ? `Người mua không mua thêm bao nhiêu, lợi nhuận &lt;b class=&quot;neg&quot;&gt;giảm ${fmt(pi0-pi,0)}&lt;/b&gt; triệu đ.`
        : `Bán thêm được nhiều nhưng giá đã quá sát chi phí, lợi nhuận &lt;b class=&quot;neg&quot;&gt;giảm ${fmt(pi0-pi,0)}&lt;/b&gt; triệu đ.`);
    $(s.v).innerHTML = v;
  }

  /* ---------- profit vs price chart ---------- */
  const PW = 640, PH = 320, pm = {l:62, r:18, t:18, b:44}, YM = 5000;
  const px = p =&gt; pm.l + (p - PMIN)/(PMAX - PMIN) * (PW - pm.l - pm.r);
  const py = v =&gt; pm.t + (1 - v/YM) * (PH - pm.t - pm.b);
  const pr = {};
  (function buildProfit(){
    const svg = $(&#x27;chProfit&#x27;);
    for (let v = 0; v &lt;= YM; v += 1000){
      el(&#x27;line&#x27;, {x1:pm.l, x2:PW-pm.r, y1:py(v), y2:py(v), class:&#x27;g-grid&#x27;}, svg);
      el(&#x27;text&#x27;, {x:pm.l-8, y:py(v)+4, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-tick&#x27;}, svg).textContent = fmt(v,0);
    }
    for (let p = PMIN; p &lt;= PMAX; p += 10)
      el(&#x27;text&#x27;, {x:px(p), y:py(0)+18, &#x27;text-anchor&#x27;:&#x27;middle&#x27;, class:&#x27;g-tick&#x27;}, svg).textContent = p;
    el(&#x27;line&#x27;, {x1:pm.l, x2:PW-pm.r, y1:py(0), y2:py(0), class:&#x27;g-axis&#x27;}, svg);
    el(&#x27;text&#x27;, {x:PW-pm.r, y:PH-6, &#x27;text-anchor&#x27;:&#x27;end&#x27;, class:&#x27;g-title&#x27;}, svg).textContent = &#x27;Giá đặt (nghìn đ)&#x27;;
    el(&#x27;text&#x27;, {x:14, y:py(YM/2), &#x27;text-anchor&#x27;:&#x27;middle&#x27;, class:&#x27;g-title&#x27;, transform:`rotate(-90 14 ${py(YM/2)})`}, svg).textContent = &#x27;Lợi nhuận (triệu đ)&#x27;;
    [&#x27;ess&#x27;,&#x27;lux&#x27;].forEach(k =&gt; {
      const s = SC[k]; const pts = [];
      for (let p = PMIN; p &lt;= PMAX; p += 0.5) pts.push(`${px(p).toFixed(1)},${py(profit(s,p)).toFixed(1)}`);
      el(&#x27;polyline&#x27;, {points:pts.join(&#x27; &#x27;), fill:&#x27;none&#x27;, style:`stroke:var(${s.col});stroke-width:3.5;stroke-linejoin:round`}, svg);
      const o = opt(s), op = profit(s, o.p);
      el(&#x27;line&#x27;, {x1:px(o.p), x2:px(o.p), y1:py(op), y2:py(0), style:&#x27;stroke:var(--mr);stroke-width:1.3;stroke-dasharray:3 3&#x27;}, svg);
      el(&#x27;circle&#x27;, {cx:px(o.p), cy:py(op), r:5.5, style:&#x27;fill:var(--mr)&#x27;}, svg);
      el(&#x27;text&#x27;, {x:px(o.p), y:py(op)-12, &#x27;text-anchor&#x27;:&#x27;middle&#x27;, class:&#x27;g-lbl&#x27;, style:&#x27;fill:var(--mr);font-weight:700&#x27;}, svg).textContent = `đỉnh: giá ${fmt(o.p)} → ${fmt(op,0)}`;
    });
    [&#x27;ess&#x27;,&#x27;lux&#x27;].forEach(k =&gt; {
      pr[k] = {
        v: el(&#x27;line&#x27;, {style:`stroke:var(${SC[k].col});stroke-width:1.2;stroke-dasharray:2 3`}, svg),
        c: el(&#x27;circle&#x27;, {r:8, style:`fill:var(${SC[k].col});stroke:var(--sheet);stroke-width:3`}, svg)
      };
    });
  })();
  function updateProfit(){
    [&#x27;ess&#x27;,&#x27;lux&#x27;].forEach(k =&gt; {
      const p = price[k], v = profit(SC[k], p);
      pr[k].c.setAttribute(&#x27;cx&#x27;, px(p)); pr[k].c.setAttribute(&#x27;cy&#x27;, py(v));
      pr[k].v.setAttribute(&#x27;x1&#x27;, px(p)); pr[k].v.setAttribute(&#x27;x2&#x27;, px(p)); pr[k].v.setAttribute(&#x27;y1&#x27;, py(v)); pr[k].v.setAttribute(&#x27;y2&#x27;, py(0));
    });
  }

  $(&#x27;optBody&#x27;).innerHTML = [&#x27;ess&#x27;,&#x27;lux&#x27;].map(k =&gt; {
    const s = SC[k], o = opt(s);
    return `&lt;tr&gt;&lt;td&gt;&lt;span class=&quot;${k===&#x27;ess&#x27;?&#x27;e&#x27;:&#x27;l&#x27;}&quot;&gt;${k===&#x27;ess&#x27;?&#x27;Thiết yếu&#x27;:&#x27;Xa xỉ&#x27;}&lt;/span&gt;&lt;/td&gt;&lt;td&gt;${fmt(o.p)}&lt;/td&gt;&lt;td&gt;${fmt(o.q)}&lt;/td&gt;&lt;td&gt;+${fmt(o.p-MC)}&lt;/td&gt;&lt;td&gt;&lt;b&gt;${fmt(profit(s,o.p),0)}&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;`;
  }).join(&#x27;&#x27;);

  const CORE = &#x27;Đường cầu càng &lt;b&gt;dốc&lt;/b&gt;, người mua càng khó từ bỏ sản phẩm, nên nhà độc quyền càng có thể đặt giá &lt;b&gt;cao hơn nhiều so với chi phí&lt;/b&gt; mà vẫn giữ được khách. Đó là sức mạnh độc quyền lớn. Với đường cầu &lt;b&gt;thoải&lt;/b&gt;, chỉ cần tăng giá một chút là mất nhiều khách, nên dù là người bán duy nhất, doanh nghiệp cũng không thể đẩy giá lên cao.&#x27;;
  function updateInsight(){
    const pe = price.ess, pl = price.lux, qe = Qd(SC.ess,pe), ql = Qd(SC.lux,pl);
    const atOpt = Math.abs(pe - opt(SC.ess).p) &lt; 0.01 &amp;&amp; Math.abs(pl - opt(SC.lux).p) &lt; 0.01;
    let t = &#x27;&#x27;;
    if (atOpt){
      t = &#x27;Doanh nghiệp đang đặt mức giá có lợi nhất cho từng mặt hàng. Với hàng thiết yếu, doanh nghiệp đặt giá &lt;b&gt;85&lt;/b&gt;, cao hơn chi phí 65 nghìn đ/sp. Với hàng xa xỉ, doanh nghiệp chỉ đặt được &lt;b&gt;45&lt;/b&gt;, cao hơn chi phí 25 nghìn đ/sp; đặt cao hơn nữa là lợi nhuận giảm.&lt;br&gt;&lt;br&gt;&#x27;;
    } else if (linked &amp;&amp; Math.abs(pe - P0) &gt; 0.01){
      t = `Cùng đặt giá &lt;b&gt;${fmt(pe)}&lt;/b&gt;: nếu bán hàng thiết yếu, doanh nghiệp bán được ${fmt(qe)} nghìn sp, lợi nhuận &lt;span class=&quot;e&quot;&gt;${fmt(profit(SC.ess,pe),0)}&lt;/span&gt;; nếu bán hàng xa xỉ, bán được ${fmt(ql)} nghìn sp, lợi nhuận &lt;span class=&quot;l&quot;&gt;${fmt(profit(SC.lux,pl),0)}&lt;/span&gt;. `;
      t += pe &gt; P0
        ? &#x27;Khi tăng giá, người mua hàng thiết yếu phần lớn vẫn phải mua, còn người mua hàng xa xỉ bỏ đi rất nhiều.&lt;br&gt;&lt;br&gt;&#x27;
        : &#x27;Khi giảm giá, hàng xa xỉ hút thêm rất nhiều người mua, còn hàng thiết yếu bán thêm không đáng kể.&lt;br&gt;&lt;br&gt;&#x27;;
    }
    $(&#x27;insight&#x27;).innerHTML = t + CORE;
  }

  function renderAll(){ updateChart(SC.ess); updateChart(SC.lux); updateProfit(); updateInsight(); }
  function setPrice(k, p){
    p = Math.min(PMAX, Math.max(PMIN, p));
    if (linked){ price.ess = price.lux = p; } else price[k] = p;
    renderAll();
  }
  let anim = null;
  const reduce = matchMedia(&#x27;(prefers-reduced-motion: reduce)&#x27;).matches;
  function stopAnim(){ if (anim) cancelAnimationFrame(anim); anim = null; }
  function animateTo(target){
    stopAnim();
    if (reduce){ price.ess = target.ess; price.lux = target.lux; renderAll(); return; }
    const from = {...price}, t0 = performance.now(), dur = 550;
    const step = t =&gt; {
      const k = Math.min(1, (t - t0)/dur), e = 1 - Math.pow(1 - k, 3);
      price.ess = from.ess + (target.ess - from.ess)*e;
      price.lux = from.lux + (target.lux - from.lux)*e;
      if (k &gt;= 1){ price.ess = target.ess; price.lux = target.lux; }
      renderAll();
      if (k &lt; 1) anim = requestAnimationFrame(step);
    };
    anim = requestAnimationFrame(step);
  }

  buildChart(SC.ess); buildChart(SC.lux);
  $(&#x27;slEss&#x27;).addEventListener(&#x27;input&#x27;, e =&gt; { stopAnim(); setPrice(&#x27;ess&#x27;, +e.target.value); });
  $(&#x27;slLux&#x27;).addEventListener(&#x27;input&#x27;, e =&gt; { stopAnim(); setPrice(&#x27;lux&#x27;, +e.target.value); });
  $(&#x27;link&#x27;).addEventListener(&#x27;change&#x27;, e =&gt; {
    linked = e.target.checked;
    if (linked) animateTo({ess:price.ess, lux:price.ess});
  });
  $(&#x27;showMR&#x27;).addEventListener(&#x27;change&#x27;, e =&gt; { showMR = e.target.checked; renderAll(); });
  document.querySelectorAll(&#x27;[data-set]&#x27;).forEach(b =&gt; b.addEventListener(&#x27;click&#x27;, () =&gt; {
    if (b.dataset.set === &#x27;opt&#x27;){
      linked = false; $(&#x27;link&#x27;).checked = false;
      showMR = true; $(&#x27;showMR&#x27;).checked = true;
      animateTo({ess:opt(SC.ess).p, lux:opt(SC.lux).p});
    } else {
      linked = true; $(&#x27;link&#x27;).checked = true;
      const v = +b.dataset.set; animateTo({ess:v, lux:v});
    }
  }));
  renderAll();
})();
&lt;/script&gt;
