.card-h{display:flex; justify-content:space-between; align-items:flex-start; gap:10px; flex-wrap:wrap}
.card-h h2{margin:0; font-size:1.3rem; letter-spacing:-.01em}
.card-h p{margin:2px 0 0; color:var(--muted); font-size:.9rem}
