button:hover{border-color:var(--ink)}
button.primary{background:var(--ink); color:var(--sheet); border-color:var(--ink)}
button:focus-visible,input:focus-visible{outline:3px solid var(--gold); outline-offset:2px}
.bar{display:flex; flex-wrap:wrap; gap:10px 18px; align-items:center}
.bar .btns{display:flex; flex-wrap:wrap; gap:8px}
.toggle{display:flex; gap:8px; align-items:center; font-size:.92rem; cursor:pointer}
