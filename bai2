    <script>
        // Init variables and states
        window.onload = function() {
            toggleAccordion('content-1');
            resetCookies();
        }

        // Accordion utility
        function toggleAccordion(id) {
            const content = document.getElementById(id);
            const icon = document.getElementById('icon-' + id);
            
            if (content.classList.contains('active')) {
                content.classList.remove('active');
                if (icon) icon.style.transform = 'rotate(0deg)';
            } else {
                content.classList.add('active');
                if (icon) icon.style.transform = 'rotate(180deg)';
            }
        }

        function toggleAll(expand) {
            const contents = document.querySelectorAll('.accordion-content');
            contents.forEach(content => {
                const id = content.id;
                const icon = document.getElementById('icon-' + id);
                if (expand) {
                    content.classList.add('active');
                    if (icon) icon.style.transform = 'rotate(180deg)';
                } else {
                    content.classList.remove('active');
                    if (icon) icon.style.transform = 'rotate(0deg)';
                }
            });
        }

        // Utility Widget 1
        function changeUtilityFace(val) {
            const faceVal = document.getElementById('utility-val');
            const mouth = document.getElementById('utility-mouth');
            const happyEyes = document.getElementById('happy-eyes');
            const eyeL = document.getElementById('eye-l');
            const eyeR = document.getElementById('eye-r');

            if (val == 1) {
                faceVal.innerText = "Thấp / Bình thường";
                faceVal.className = "text-amber-400 font-extrabold";
                mouth.setAttribute('d', 'M30,60 Q50,65 70,60');
                happyEyes.classList.add('hidden');
                eyeL.classList.remove('hidden');
                eyeR.classList.remove('hidden');
            } else if (val == 2) {
                faceVal.innerText = "Khá thỏa mãn";
                faceVal.className = "text-orange-400 font-extrabold";
                mouth.setAttribute('d', 'M30,55 Q50,75 70,55');
                happyEyes.classList.add('hidden');
                eyeL.classList.remove('hidden');
                eyeR.classList.remove('hidden');
            } else {
                faceVal.innerText = "Cực kỳ hạnh phúc! ♥";
                faceVal.className = "text-rose-400 font-extrabold";
                mouth.setAttribute('d', 'M25,50 Q50,85 75,50');
                happyEyes.classList.remove('hidden');
                eyeL.classList.add('hidden');
                eyeR.classList.add('hidden');
            }
        }

        // Cookie simulator Widget 2
        let cookiesEaten = 0;
        const muValues = [10, 6, 2, -3];

        function eatCookie() {
            if (cookiesEaten < 4) {
                cookiesEaten++;
                updateCookieDisplay();
            }
        }

        function resetCookies() {
            cookiesEaten = 0;
            updateCookieDisplay();
        }

        function updateCookieDisplay() {
            const plate = document.getElementById('cookie-plate');
            const countLabel = document.getElementById('cookie-count');
            const muReadout = document.getElementById('mu-readout');
            const emoji = document.getElementById('eater-emoji');
            const status = document.getElementById('eater-status');

            countLabel.innerText = cookiesEaten;
            plate.innerHTML = '';

            for (let i = 0; i < cookiesEaten; i++) {
                plate.innerHTML += `<div class="w-6 h-6 bg-amber-700 rounded-full border-2 border-amber-900 shadow flex items-center justify-center text-[8px] text-amber-200 font-bold">🍪</div>`;
            }

            if (cookiesEaten === 0) {
                muReadout.innerText = "--";
                emoji.innerText = "😋";
                status.innerText = "Sẵn sàng!";
            } else if (cookiesEaten === 1) {
                muReadout.innerText = "+10 (Rất cao!)";
                emoji.innerText = "😍";
                status.innerText = "Ngon tuyệt!";
            } else if (cookiesEaten === 2) {
                muReadout.innerText = "+6 (Vừa phải)";
                emoji.innerText = "😊";
                status.innerText = "Cũng ổn!";
            } else if (cookiesEaten === 3) {
                muReadout.innerText = "+2 (Rất ít)";
                emoji.innerText = "😐";
                status.innerText = "Hơi ngấy rồi...";
            } else if (cookiesEaten === 4) {
                muReadout.innerText = "-3 (Quá ngấy!)";
                emoji.innerText = "🤢";
                status.innerText = "Thôi ngưng!";
            }
        }

        // Widget 3 Bar highlight
        function highlightBar(unit, mu) {
            const expl = document.getElementById('bar-explanation');
            expl.innerHTML = `<strong class="text-rose-400">Đơn vị thứ ${unit}:</strong> Mang lại MU = ${mu}. ${mu > 5 ? 'Thỏa mãn lớn!' : mu > 0 ? 'Thỏa mãn ít.' : 'Đã bão hòa.'}`;
        }
    </script>
