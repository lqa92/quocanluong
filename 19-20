    function getVocabularyForTab(tabNum) {
        if (tabNum >= 1 && tabNum <= 16) {
            return originalVocabulary[tabNum];
        } else if (tabNum === 17) {
            // Lấy ngẫu nhiên 7 từ phó từ
            const shuffledBusa = shuffle([...originalVocabulary[17]]);
            return shuffledBusa.slice(0, 7);
        } else if (tabNum === 18) {
            // Tổng ôn tập
            let totalCombined = [];
            for (let i = 1; i <= 17; i++) {
                totalCombined = totalCombined.concat(originalVocabulary[i]);
            }
            return totalCombined;
        }
        return [];
    }

    let activeTab = 1;
    let selectedKrCard = null;
    let selectedViCard = null;
    let matchedCount = 0;
    let totalPairs = 0;

    function switchTab(tabIndex, tabTitleText) {
        activeTab = tabIndex;
        document.getElementById('current-tab-title').innerText = tabTitleText;
        
        document.querySelectorAll('.tab-btn').forEach((btn, index) => {
            btn.classList.toggle('active', index + 1 === tabIndex);
        });

        const selectWrapper = document.getElementById('select-wrapper');
        const infoModeText = document.getElementById('info-mode-text');
        
        if (tabIndex === 18) {
            selectWrapper.style.display = 'block';
            infoModeText.style.display = 'none';
        } else if (tabIndex === 17) {
            selectWrapper.style.display = 'none';
            infoModeText.style.display = 'block';
            infoModeText.innerText = 'Chế độ: Kiểm tra ngẫu nhiên 7 phó từ mỗi lần';
        } else {
            selectWrapper.style.display = 'none';
            infoModeText.style.display = 'block';
            infoModeText.innerText = 'Chế độ: Học toàn bộ từ vựng của bài';
        }

        initGame();
    }

    function shuffle(array) {
        let currentIndex = array.length, randomIndex;
        while (currentIndex != 0) {
            randomIndex = Math.floor(Math.random() * currentIndex);
            currentIndex--;
            [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
        }
        return array;
    }

    function updateProgressScore() {
        document.getElementById('correct-count').innerText = matchedCount;
        document.getElementById('max-count').innerText = totalPairs;
    }

    function initGame() {
        selectedKrCard = null;
        selectedViCard = null;
        matchedCount = 0;
        document.getElementById('success-banner').style.display = 'none';

        const tabSourceData = getVocabularyForTab(activeTab);
        const shuffledSource = shuffle([...tabSourceData]);

        if (activeTab === 18) {
            totalPairs = parseInt(document.getElementById('pair-count').value);
        } else {
            totalPairs = tabSourceData.length;
        }
        
        const selectedPairs = shuffledSource.slice(0, Math.min(totalPairs, tabSourceData.length));
        totalPairs = selectedPairs.length; 

        updateProgressScore();

        const krList = selectedPairs.map((pair, index) => ({ text: pair.kr, id: index }));
        const viList = selectedPairs.map((pair, index) => ({ text: pair.vi, id: index }));

        shuffle(krList);
        shuffle(viList);

        const krColumn = document.getElementById('korean-column');
        krColumn.innerHTML = '';
        krList.forEach(item => {
            const card = document.createElement('div');
            card.className = 'word-card';
            card.innerText = item.text;
            card.dataset.id = item.id;
            card.onclick = () => onCardClicked(card, 'kr');
            krColumn.appendChild(card);
        });

        const viColumn = document.getElementById('vietnamese-column');
        viColumn.innerHTML = '';
        viList.forEach(item => {
            const card = document.createElement('div');
            card.className = 'word-card';
            card.innerText = item.text;
            card.dataset.id = item.id;
            card.onclick = () => onCardClicked(card, 'vi');
            viColumn.appendChild(card);
        });
    }

    function onCardClicked(card, type) {
        if (card.classList.contains('matched') || card.classList.contains('wrong')) return;

        if (type === 'kr') {
            if (selectedKrCard) selectedKrCard.classList.remove('selected');
            selectedKrCard = card;
            card.classList.add('selected');
        } else {
            if (selectedViCard) selectedViCard.classList.remove('selected');
            selectedViCard = card;
            card.classList.add('selected');
        }

        if (selectedKrCard && selectedViCard) {
            verifyMatchedPair();
        }
    }

    function verifyMatchedPair() {
        const krId = selectedKrCard.dataset.id;
        const viId = selectedViCard.dataset.id;

        if (krId === viId) {
            selectedKrCard.className = 'word-card matched';
            selectedViCard.className = 'word-card matched';
            matchedCount++;
            updateProgressScore();
            
            selectedKrCard = null;
            selectedViCard = null;

            if (matchedCount === totalPairs) {
                document.getElementById('success-banner').style.display = 'block';
            }
        } else {
            const tempKr = selectedKrCard;
            const tempVi = selectedViCard;
            
            tempKr.classList.add('wrong');
            tempVi.classList.add('wrong');
            
            selectedKrCard = null;
            selectedViCard = null;

            setTimeout(() => {
                tempKr.classList.remove('wrong', 'selected');
                tempVi.classList.remove('wrong', 'selected');
            }, 400);
        }
    }

    window.onload = initGame;
</script>

