    <style>
        :root {
            --bg-main: #0b1329;
            --card-bg: #131d38;
            --primary: #38bdf8;
            --primary-bg: #1e3a8a;
            --success: #34d399;
            --success-bg: #064e3b;
            --danger: #f87171;
            --danger-bg: #451a1a;
            --text-dark: #f1f5f9;
            --text-muted: #94a3b8;
            --border-color: #334155;
            --radius: 16px;
            --shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
        }

        body {
            font-family: 'Be Vietnam Pro', 'Noto Sans KR', sans-serif;
            background-color: var(--bg-main);
            color: var(--text-dark);
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Nút quay về */
        .back-btn {
            display: inline-flex;
            align-items: center;
            color: #38bdf8;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s ease;
        }
        .back-btn:hover {
            color: #7dd3fc;
        }

        /* Top Header Brand */
        .brand-header {
            background: #0f172a;
            padding: 30px 20px 24px 20px;
            text-align: center;
            border-bottom: 1px solid var(--border-color);
        }

        .brand-title {
            font-size: 28px;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 10px 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .brand-subtitle {
            font-size: 20px;
            font-weight: 700;
            color: #38bdf8;
            margin: 0 0 12px 0;
        }

        .brand-desc {
            font-size: 14px;
            color: var(--text-muted);
            margin: 0;
        }

        /* Main Container */
        .main-container {
            max-width: 1100px;
            width: 100%;
            margin: 24px auto 40px auto;
            padding: 0 20px;
            box-sizing: border-box;
            flex: 1;
        }

        /* Tabs Wrapper Area */
        .tabs-container {
            background: var(--card-bg);
            padding: 20px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            margin-bottom: 24px;
        }

        .tabs-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
        }

        .tab-btn {
            padding: 8px 16px;
            border: 1px solid var(--border-color);
            background: #0b1329;
            font-size: 13px;
            font-weight: 600;
            color: var(--text-muted);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s;
        }

        .tab-btn:hover {
            background: #1e293b;
            color: #f8fafc;
        }

        .tab-btn.active {
            background: #0284c7;
            color: white;
            border-color: #38bdf8;
            box-shadow: 0 2px 8px rgba(2, 132, 199, 0.4);
        }

        .tab-btn.special-tab {
            background: #451a03;
            border-color: #78350f;
            color: #fcd34d;
        }

        .tab-btn.special-tab.active {
            background: #d97706;
            color: white;
            border-color: #fbbf24;
        }

        /* Configuration Panel */
        .config-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: var(--card-bg);
            padding: 16px 24px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
            margin-bottom: 24px;
        }

        .config-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .config-left label {
            font-size: 14px;
            font-weight: 600;
            color: #cbd5e1;
        }

        .config-left select {
            padding: 8px 14px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            background-color: #0f172a;
            font-size: 14px;
            font-weight: 600;
            outline: none;
            color: #f8fafc;
            cursor: pointer;
        }

        /* Workspace Board */
        .workspace-card {
            background: var(--card-bg);
            padding: 32px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border: 1px solid var(--border-color);
        }

        .workspace-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 24px;
        }

        .current-tab-title {
            font-size: 22px;
            font-weight: 800;
            color: #38bdf8;
        }

        .btn-refresh {
            background: #1e293b;
            color: #f8fafc;
            border: 1px solid var(--border-color);
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .btn-refresh:hover {
            background: #334155;
        }

        /* Matching Grid Column */
        .game-board {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 32px;
        }

        .column-header {
            font-size: 16px;
            font-weight: 700;
            text-align: center;
            padding-bottom: 12px;
            margin-bottom: 16px;
        }

        .column-kr .column-header {
            color: #38bdf8;
            border-bottom: 2px solid #0284c7;
        }

        .column-vi .column-header {
            color: #34d399;
            border-bottom: 2px solid #059669;
        }

        .column-cards {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* Cards Styles */
        .word-card {
            background: #0b1329;
            border: 1px solid var(--border-color);
            padding: 16px 20px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 500;
            text-align: left;
            cursor: pointer;
            user-select: none;
            transition: all 0.2s ease;
            color: var(--text-dark);
        }

        .word-card:hover:not(.matched) {
            border-color: #38bdf8;
            background-color: #1e293b;
            transform: translateY(-1px);
        }

        .word-card.selected {
            background-color: var(--primary-bg);
            border-color: #38bdf8;
            color: #38bdf8;
            font-weight: 600;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.3);
        }

        .word-card.matched {
            background-color: var(--success-bg);
            border-color: #059669;
            color: var(--success);
            cursor: default;
            font-weight: 500;
            opacity: 0.3;
            pointer-events: none;
        }

        .word-card.wrong {
            background-color: var(--danger-bg);
            border-color: #f87171;
            color: #fca5a5;
            animation: shake 0.3s;
        }

        /* Success Banner */
        .success-banner {
            display: none;
            text-align: center;
            color: #34d399;
            font-size: 16px;
            font-weight: 600;
            padding: 16px;
            background-color: var(--success-bg);
            border: 1px solid #059669;
            border-radius: 12px;
            margin-bottom: 24px;
        }

        /* Footer Copyright */
        .footer {
            text-align: center;
            padding: 24px;
            margin-top: auto;
            border-top: 1px solid var(--border-color);
            background: #0f172a;
            font-size: 13px;
            color: var(--text-muted);
            line-height: 1.6;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-4px); }
            75% { transform: translateX(4px); }
        }

        @media (max-width: 768px) {
            .game-board { grid-template-columns: 1fr; gap: 20px; }
            .config-bar { flex-direction: column; gap: 16px; align-items: stretch; }
        }
